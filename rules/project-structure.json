{
  "version": "1.1.0",
  "framework": "flutter",
  "target_root": "apps/mobile",
  "required_paths": [
    "pubspec.yaml",
    "pubspec.lock",
    "analysis_options.yaml",
    ".env.example",
    ".gitignore",
    "README.md",
    "android",
    "ios",
    "assets/images",
    "assets/fonts",
    "lib/main.dart",
    "lib/app/app.dart",
    "lib/app/bootstrap.dart",
    "lib/app/router.dart",
    "lib/core/config/env.dart",
    "lib/core/errors/app_failure.dart",
    "lib/core/network/api_client.dart",
    "lib/core/network/api_error.dart",
    "lib/core/security/secure_storage.dart",
    "lib/core/theme/app_theme.dart",
    "lib/features",
    "lib/shared/widgets",
    "lib/l10n/app_en.arb",
    "test/helpers",
    "test/goldens",
    "integration_test/app_test.dart"
  ],
  "required_directories": [
    "android",
    "ios",
    "assets/images",
    "assets/fonts",
    "lib/features",
    "lib/shared/widgets",
    "test/helpers",
    "test/goldens"
  ],
  "conditional_path_groups": [
    {
      "name": "realtime",
      "trigger_globs": ["lib/core/realtime/realtime_client.dart", "lib/features/*/data/*realtime*.dart"],
      "required_paths": ["lib/core/realtime/realtime_client.dart", "lib/core/realtime/realtime_event.dart", "lib/core/realtime/realtime_state.dart", "test/core/realtime/realtime_client_test.dart", "integration_test/realtime_test.dart"],
      "required_directories": [],
      "required_source_patterns": [
        {"id": "realtime-websocket-dependency", "globs": ["pubspec.yaml"], "pattern": "web_socket_channel:", "ignore_case": false, "message": "Flutter realtime requires the WebSocket channel dependency."},
        {"id": "realtime-environment", "globs": [".env.example"], "pattern": "^REALTIME_WS_URL=", "ignore_case": false, "message": "The example environment must declare the realtime endpoint."}
      ]
    }
  ],
  "source_rules": [
    {"id": "no-reusable-token-in-websocket-url", "globs": ["lib/**/*.dart"], "pattern": "(?:access_?token|jwt|bearer)=", "ignore_case": true, "scan_strings": true, "message": "Do not place reusable credentials in WebSocket URLs."}
  ],
  "feature_path_pattern": "lib/features/<feature>",
  "module_path_pattern": "lib/features/<module>",
  "module_naming": {
    "style": "snake_case",
    "ambiguous_names": ["identity", "work", "operations", "data", "management", "collaboration"],
    "familiar_fallback_names": ["accounts", "authentication", "users", "notifications", "articles", "blog", "posts", "tasks", "todos", "webhooks", "chat", "files", "attachments", "payments", "orders", "products", "reports"],
    "responsibility_packages": [],
    "max_lines": [
      {"globs": ["data/**/*.dart", "domain/**/*.dart", "application/**/*.dart", "presentation/**/*.dart"], "maximum": 250}
    ]
  },
  "required_feature_paths": ["data", "domain", "application", "presentation"],
  "forbidden_patterns": [
    "secret or signing material in source control",
    "unvalidated network or persisted data",
    "domain behavior coupled to widgets or plugins",
    "unhandled permission denial or application lifecycle",
    "application code copied from the behavior pack"
  ]
}
